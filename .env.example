# Apni Padhai — Environment Variables
# Copy this file to `.env.local` and fill in real values.

# Base URL for the Apni Padhai REST API (RTK Query).
# Falls back to https://api.apnipadhaipublication.com/v1 when unset.
NEXT_PUBLIC_API_BASE_URL=https://api.apnipadhaipublication.com/v1

# Public app URL (used for canonical links / sitemap).
NEXT_PUBLIC_SITE_URL=https://apnipadhai.com

# ---- CORS ----
# Comma-separated origins allowed to call the /api endpoints from the browser
# (e.g. the WordPress storefront calling /api/books). Supports wildcards like
# https://*.example.com. Same-origin requests are always allowed. Leave empty
# for same-origin only; do not include API paths.
CORS_ALLOWED_ORIGINS=https://apnipadhai.vercel.app,https://apnipadhaipublication.com

# ---- WooCommerce REST API (server-side only, never NEXT_PUBLIC_) ----
# Consumer key/secret from WooCommerce > Settings > Advanced > REST API.
# The store catalog (books) and order checkout are handled by WooCommerce.
WOO_URL=https://apnipadhaipublication.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
# How often the books catalog is re-fetched from WooCommerce (seconds).
BOOKS_REVALIDATE_SECONDS=60

# WordPress source (posts, PYQs, YouTube data). Defaults to WOO_URL.
WP_URL=https://apnipadhaipublication.com
# How often WordPress content is re-fetched (seconds).
WP_REVALIDATE_SECONDS=60

# ---- YouTube ----
# To show ALL channel videos (not just the latest 15 from the RSS feed), create
# a Google API key with the YouTube Data API v3 enabled and set it here:
# https://console.cloud.google.com/apis/credentials
# When empty, the app falls back to the channel RSS feed (latest ~15 videos).
YOUTUBE_API_KEY=

# ---- MongoDB (admin portal content store, server-side only, never NEXT_PUBLIC_) ----
# The /admin portal stores site content, blog posts, feedback, results and
# managed pages in MongoDB. When MONGODB_URI is empty the admin sections show a
# "not configured" banner and the public site falls back to WordPress content.
MONGODB_URI=
# Optional database name (defaults to `apni_padhai`).
MONGODB_DB=apni_padhai

# ---- WordPress admin (legacy) ----
# Previously used to write wp/v2 content from the admin portal. Now that the
# portal writes to MongoDB these are only needed if you want the old
# WordPress-driven admin behavior back. Application password format:
#   username + "application password" from Users > Profile > Application Passwords.
WP_APP_USERNAME=
WP_APP_PASSWORD=

# Optional: secret required to create/update/delete books via POST/PUT/DELETE
# /api/books. Send it as `x-admin-token` or `Authorization: Bearer <token>`.
# Leave empty to disable admin access. Set a strong value in production.
ADMIN_API_TOKEN=
# Optional: separate HMAC secret for admin login sessions. Set a long random value
# in production so admin sessions do not share payment signing material.
ADMIN_SESSION_SECRET=

# ---- PhonePe Payment Gateway (server-side only, never NEXT_PUBLIC_) ----
# Two integration modes are supported:
#
# v2 (Standard Checkout, OAuth2) — RECOMMENDED
#   Set PHONEPE_CLIENT_ID (your merchant ID, starts with SU) and
#   PHONEPE_CLIENT_SECRET (from PhonePe Dashboard > Settings > API Keys).
#   The SDK handles OAuth2 token exchange automatically.
#
# v1 (Classic PG, salt-based)
#   Set PHONEPE_MERCHANT_ID, PHONEPE_SALT_KEY and PHONEPE_SALT_INDEX.
#   When both v1 and v2 credentials are present, v2 takes priority.
#
# Mode:
#   mock = no real payment, simulates the full flow (default, for local testing)
#   test = PhonePe sandbox (https://api-preprod.phonepe.com/apis/pg-sandbox)
#   live = production (https://api.phonepe.com/apis/hermes)
PHONEPE_ENV=mock
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
# Optional bearer token for the S2S callback (/api/phonepe/callback,
# /api/phonepe/webhook). PhonePe itself does NOT send one — leave empty to rely
# on the X-VERIFY signature alone. Set it to restrict who may hit the endpoint
# (useful when proxying callbacks through your own infrastructure or for test
# scripts): requests must then present `Authorization: Bearer <token>`.
PHONEPE_S2S_TOKEN=
# Optional override for the gateway base URL (leave empty to use the defaults above).
PHONEPE_API_BASE_URL=
# Base URL used to build the PhonePe redirect + callback URLs. MUST match the
# payment URL/domain registered with PhonePe during onboarding — PhonePe allows
# ONE redirect domain per merchant and blocks every transaction
# (INTERNAL_SECURITY_BLOCK_1: "Payment blocked as the payment URL doesn't match
# the one you shared during onboarding") if the domain differs. This app's
# merchant is registered with https://apnipadhaipublication.com, so keep this
# set to that. Do NOT point it at the Vercel domain unless PhonePe support has
# explicitly added it to the merchant account.
#
# The registered domain must also serve:
#   /payment/status (post-payment result page)
#   /api/phonepe/callback  (+ /api/phonepe/webhook alias)
#   /api/payments/* (verify / resume)
# The WordPress host should reverse-proxy those paths to this app.
PHONEPE_REDIRECT_BASE_URL=https://apnipadhaipublication.com

# Secret used to HMAC-sign the server-side order token. Use a long random string in production.
PAYMENT_SIGNING_SECRET=

# ---- Customer Notifications (email / SMS / WhatsApp) ----
# Order-success and cart-reminder messages are sent to whichever channels are configured.
# Leave a channel's vars empty to skip it. All channels are optional.

# Email (any SMTP provider; Gmail app password works and is free).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional custom sender (defaults to SMTP_USER).
SMTP_FROM=

# SMS (MSG91 - transactional SMS, country code 91 default).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_COUNTRY_CODE=91

# WhatsApp (Meta Cloud API - free business messaging, no extra cost).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM=
